+    }
+    else if ( IsEqualGUID( runtimeClassId, &CLSID_XAccessibilityImpl ) )
+    {
+        /* Captions and high contrast report off. */
+        return XAccessibilityImplQueryInterface( interfaceId, out );
+    }
     else if ( IsEqualGUID( runtimeClassId, &CLSID_XGameRuntimeFeatureImpl ) )
     {
         return IXGameRuntimeFeatureImpl_QueryInterface( x_game_runtime_feature, interfaceId, out );
