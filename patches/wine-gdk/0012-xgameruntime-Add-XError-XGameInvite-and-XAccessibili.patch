+/*
+ * Xbox Game runtime Library
+ *  GDK Component: XError, XGameInvite and XAccessibility class entry points
+ *
+ * Declares the QueryApiImpl hooks for three classes
+ * the game asks for (XErrorImpl, XGameInviteImpl, XAccessibilityImpl).
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef XERRORINVITEACCESSIBILITY_H
+#define XERRORINVITEACCESSIBILITY_H
+
+#include <windows.h>
+
+/* Class ids from the GDK COM reference and research xerror.idl, xgameinvite.idl, xaccessibility.idl. */
+static const GUID CLSID_XErrorImpl = { 0x8ca467f7, 0x22e8, 0x4096, { 0x84, 0x56, 0xbb, 0x8a, 0xa1, 0x3f, 0x79, 0xd8 } };
+static const GUID CLSID_XGameInviteImpl = { 0x0651aae2, 0x4012, 0x4077, { 0xbf, 0x84, 0x8b, 0x90, 0x97, 0x09, 0x0e, 0x2c } };
+static const GUID CLSID_XAccessibilityImpl = { 0x3e241977, 0x6237, 0x41e9, { 0x85, 0x59, 0x10, 0x2c, 0x2d, 0x99, 0x83, 0xf1 } };
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+HRESULT XErrorImplQueryInterface( REFIID iid, void **out );
+HRESULT XGameInviteImplQueryInterface( REFIID iid, void **out );
+HRESULT XAccessibilityImplQueryInterface( REFIID iid, void **out );
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* XERRORINVITEACCESSIBILITY_H */
