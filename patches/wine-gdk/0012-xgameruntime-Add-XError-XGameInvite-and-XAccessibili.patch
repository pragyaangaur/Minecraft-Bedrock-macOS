diff --git a/dlls/xgameruntime/main.c b/dlls/xgameruntime/main.c
index 48b41ae..460027d 100644
--- a/dlls/xgameruntime/main.c
+++ b/dlls/xgameruntime/main.c
@@ -22,6 +22,7 @@
 #include "private.h"
 #include "GDKComponent/InitInternalGDKC.h"
 #include "GDKComponent/System/XPackageGame.h"
+#include "GDKComponent/System/XErrorInviteAccessibility.h"
 
 #include "ntstatus.h"
 
@@ -256,6 +257,21 @@ HRESULT WINAPI QueryApiImpl( const GUID *runtimeClassId, REFIID interfaceId, voi
         /* No protocol activations. */
         return XGameProtocolImplQueryInterface( interfaceId, out );
     }
+    else if ( IsEqualGUID( runtimeClassId, &CLSID_XErrorImpl ) )
+    {
+        /* Error callback and options are stored, never fired. */
+        return XErrorImplQueryInterface( interfaceId, out );
+    }
+    else if ( IsEqualGUID( runtimeClassId, &CLSID_XGameInviteImpl ) )
+    {
+        /* Registration returns a token, no invite is delivered. */
