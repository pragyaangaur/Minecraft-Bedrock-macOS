  */
 
 #include "../../private.h"
+#include <winhttp.h>
 
 #include <cstring>
 #include <atomic>
 
 WINE_DEFAULT_DEBUG_CHANNEL(gdkc);
 
+/* LibHttpClient asks for the TLS settings and certificate
+ * pins of every URL before it connects. Answer with TLS 1.2 and 1.3 and no
+ * extra pins, so ordinary schannel certificate validation still applies. */
+static const SIZE_T security_info_size = sizeof(XNetworkingSecurityInformation);
+
+static HRESULT WINAPI SecurityInformationProvider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    switch (op)
+    {
+        case XAsyncOp::Begin:
+            return ::XAsyncSchedule( data->async, 0 );
+        case XAsyncOp::DoWork:
+            ::XAsyncComplete( data->async, S_OK, security_info_size );
+            return S_OK;
+        case XAsyncOp::GetResult:
+        {
+            XNetworkingSecurityInformation *info = (XNetworkingSecurityInformation *)data->buffer;
+            info->enabledHttpSecurityProtocolFlags = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2 | WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_3;
+            info->thumbprintCount = 0;
+            info->thumbprints = nullptr;
+            return S_OK;
+        }
+        default:
+            return S_OK;
+    }
+}
+
+static HRESULT QuerySecurityInformation( const void *identity, XAsyncBlock *asyncBlock )
+{
+    return ::XAsyncBegin( asyncBlock, nullptr, identity, __func__, SecurityInformationProvider );
+}
+
+static HRESULT SecurityInformationResult( const void *identity, XAsyncBlock *asyncBlock, SIZE_T size, SIZE_T *used, UINT8 *buffer, XNetworkingSecurityInformation **info )
+{
+    HRESULT hr = ::XAsyncGetResult( asyncBlock, identity, size, buffer, used );
+    if ( SUCCEEDED(hr) && info ) *info = (XNetworkingSecurityInformation *)buffer;
+    return hr;
+}
+
+static const char security_identity_utf8 = 0, security_identity_utf16 = 0;
+
 class XNetworkingImpl : 
     public IXNetworkingImpl
 {
@@ -108,38 +150,34 @@ public:
 
